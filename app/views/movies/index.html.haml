%p{style: "color: green"}= notice

%h1 Movies

= form_with url: movies_path, method: :get, id: "ratings_form" do |f|
  - @all_ratings.each do |rating|
    = check_box_tag "ratings[#{rating}]", "1", @ratings_to_show.include?(rating), id: "ratings_#{rating}"
    = label_tag "ratings_#{rating}", rating
  - if @sort_by
    = hidden_field_tag :sort_by, @sort_by
  = f.submit "Refresh", id: "ratings_submit"

%table{id: "movies"}
  %thead
    %tr
      %th{class: ("hilite" if @sort_by == "title")}
        = link_to "Movie Title", movies_path(sort_by: "title", ratings: params[:ratings]), id: "title_header"
      %th Classificação
      %th{class: ("hilite" if @sort_by == "release_date")}
        = link_to "Release Date", movies_path(sort_by: "release_date", ratings: params[:ratings]), id: :release_date_header
      %th Sinopse
      %th Ações
  %tbody
    - @movies.each do |movie|
      %tr
        %td= link_to movie.title, movie
        %td= movie.rating
        %td= link_to movie.release_date.strftime("%d/%m/%Y"), movie
        %td= movie.description
        %td
          = link_to "Editar", edit_movie_path(movie)
          = " | "
          = link_to "Excluir", movie, data: { turbo_method: :delete, turbo_confirm: "Tem certeza?" }

= link_to "Add new movie", new_movie_path
%h3 Search TMDb for a movie
= form_with url: search_tmdb_movies_path, method: :post do |f|
  = f.label :search_terms, "Search Terms"
  = f.text_field :search_terms
  = f.submit "Search TMDb"
